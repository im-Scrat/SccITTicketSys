# =============================================================
#  Docker Compose environment for the SccIT project
#  Copy to ".env" and adjust as needed:  cp .env.example .env
#  These values are consumed by compose.yaml (NOT by Laravel).
#  Laravel reads its own backend/.env.
# =============================================================

# ----- Compose -----------------------------------------------
# Prefixes every container / network / volume with "sccit_"
COMPOSE_PROJECT_NAME=sccit

# ----- PostgreSQL --------------------------------------------
POSTGRES_DB=school_it_service_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=scc26
# Standardised on 5432 for host + container (no 5433 anywhere).
# Requires the Windows PostgreSQL service to be stopped (see docs).
POSTGRES_HOST_PORT=5432

# ----- Redis -------------------------------------------------
# Redis requires auth even in dev; published on localhost only.
REDIS_PASSWORD=scc26redis
REDIS_HOST_PORT=6379

# ----- HTTP entrypoint (Nginx, single origin) ----------------
# Browser hits everything through here: / (frontend) and /api (Laravel).
# Host 80 is taken by Herd, so we use 8080.
APP_HOST_PORT=8080

# ----- Mailpit (local mail catcher) --------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
