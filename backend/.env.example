APP_NAME="SccIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database: Dockerized PostgreSQL 17 -----
# DB_HOST is the compose service name; reachable inside the Docker network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_it_service_management
DB_USERNAME=postgres
DB_PASSWORD=scc26

# ----- Session / cache / queue all on Redis (scale-ready) -----
SESSION_DRIVER=redis
# Idle-session lifetime in minutes (FR-AUTH-009: default 8 hours).
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Set to true behind HTTPS in production so cookies are Secure-only.
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ----- Broadcasting: Laravel Reverb (WP-A) -----
# Reverb runs as the internal `reverb` compose service. It has NO published
# host port: browsers reach it same-origin through nginx at /reverb/app/…, and
# Laravel (app + queue containers) publishes to it directly over the compose
# network. So REVERB_HOST/REVERB_PORT here are the INTERNAL address Laravel
# dials — not :8080, which is the nginx entrypoint. The listening port (6001)
# is fixed in compose.yaml alongside the nginx upstream that must match it.
#
# ID / KEY / SECRET: generate your own, e.g.
#   docker compose exec app php -r "echo random_int(100000,999999), ' ', bin2hex(random_bytes(10)), ' ', bin2hex(random_bytes(10)), PHP_EOL;"
# The SECRET signs channel authorizations — it never leaves the server. The
# KEY is a public identifier; the SPA fetches it at runtime from
# GET /api/broadcasting/config, so nothing Reverb-related is baked into the
# frontend build and there are no VITE_REVERB_* variables.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http
# Hostnames allowed to open a socket (Origin host, port ignored). Unset = none.
REVERB_ALLOWED_ORIGINS=localhost
FILESYSTEM_DISK=local

# ----- Sanctum SPA (single-origin via Nginx on :8080) -----
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# ----- Auth security tunables (config/security.php) -----
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MIN_CLASSES=3
AUTH_REGISTRATION_PER_HOUR=5
AUTH_PASSWORD_PER_HOUR=6

# ----- Redis (Dockerized, password-protected) -----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=scc26redis
REDIS_PORT=6379

# ----- Mail: Mailpit container -----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sccit.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- AI: Gemini via laravel/ai (WP-H) -----
# Get a key at https://aistudio.google.com/apikey and set it in your own
# untracked backend/.env — never here, never in any committed file, never in
# a Docker build arg or image layer. Config path: config('ai.providers.gemini.key').
# Left empty in dev/CI is fine: AI features degrade to a clear "unavailable"
# error rather than a crash (see App\Domains\KnowledgeBase\Services\AiSettings).
GEMINI_API_KEY=
GEMINI_URL=

VITE_APP_NAME="${APP_NAME}"
