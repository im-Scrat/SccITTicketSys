APP_NAME="SccIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database: Dockerized PostgreSQL 17 -----
# DB_HOST is the compose service name; reachable inside the Docker network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_it_service_management
DB_USERNAME=postgres
DB_PASSWORD=scc26

# ----- Session / cache / queue all on Redis (scale-ready) -----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Broadcasting: 'null' for now; Reverb is wired in a later phase.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# ----- Sanctum SPA (single-origin via Nginx on :8080) -----
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# ----- Redis (Dockerized, password-protected) -----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=scc26redis
REDIS_PORT=6379

# ----- Mail: Mailpit container -----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sccit.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
