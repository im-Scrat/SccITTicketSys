APP_NAME="SccIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database: Dockerized PostgreSQL 17 -----
# DB_HOST is the compose service name; reachable inside the Docker network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_it_service_management
DB_USERNAME=postgres
DB_PASSWORD=scc26

# ----- Session / cache / queue all on Redis (scale-ready) -----
SESSION_DRIVER=redis
# Idle-session lifetime in minutes (FR-AUTH-009: default 8 hours).
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Set to true behind HTTPS in production so cookies are Secure-only.
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Broadcasting: 'null' for now. Real-time (e.g. future Floor Plan position
# updates) will use Laravel Reverb. To enable later:
#   composer require laravel/reverb && php artisan install:broadcasting
# then set BROADCAST_CONNECTION=reverb and fill the placeholders below.
BROADCAST_CONNECTION=null
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
FILESYSTEM_DISK=local

# ----- Sanctum SPA (single-origin via Nginx on :8080) -----
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# ----- Auth security tunables (config/security.php) -----
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MIN_CLASSES=3
AUTH_REGISTRATION_PER_HOUR=5
AUTH_PASSWORD_PER_HOUR=6

# ----- Redis (Dockerized, password-protected) -----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=scc26redis
REDIS_PORT=6379

# ----- Mail: Mailpit container -----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sccit.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
