# =============================================================
#  SccIT — Laravel PRODUCTION environment (template).
#  Copy to `backend/.env.production` and fill real secrets:
#      cp backend/.env.production.example backend/.env.production
#      docker compose exec app php artisan key:generate --show   # paste below
#
#  Consumed by the production app/queue/scheduler containers via
#  compose.prod.yaml (env_file). The production entrypoint runs
#  config:cache / route:cache / event:cache against these values.
# =============================================================

APP_NAME="SccIT"
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY
APP_DEBUG=false
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Containers: log to stderr so `docker logs` captures everything.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (prod compose service `postgres_prod`) -----
DB_CONNECTION=pgsql
DB_HOST=postgres_prod
DB_PORT=5432
DB_DATABASE=school_it_service_management
DB_USERNAME=postgres
DB_PASSWORD=scc26

# ----- Session / cache / queue on Redis -----
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# ----- Broadcasting: Laravel Reverb (prod compose service `reverb_prod`) -----
# Internal only — no published host port. Browsers connect same-origin through
# nginx_prod at /reverb/app/…; Laravel publishes to reverb_prod:6001 over the
# prod network. Generate a production ID / KEY / SECRET distinct from dev's.
# The SECRET never leaves the server; rotating any of these needs only
# `up -d --force-recreate app_prod queue_prod scheduler_prod reverb_prod` —
# no image rebuild, because the SPA reads the KEY at runtime.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb_prod
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost

# ----- Sanctum SPA (served by prod Nginx on :8081) -----
SANCTUM_STATEFUL_DOMAINS=localhost:8081,localhost,127.0.0.1:8081
FRONTEND_URL=http://localhost:8081

# ----- Redis (prod compose service `redis_prod`) -----
REDIS_CLIENT=phpredis
REDIS_HOST=redis_prod
REDIS_PASSWORD=scc26redis
REDIS_PORT=6379

# ----- Mail -----
# Local prod testing: deliver to the isolated Mailpit in compose.prod.yaml
# (UI at http://localhost:8026). For a REAL deployment, replace MAIL_HOST/PORT/
# USERNAME/PASSWORD/SCHEME with your real SMTP provider's credentials.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit_prod
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sccit.local"
MAIL_FROM_NAME="${APP_NAME}"

# ----- Seeded administrator (AdminUserSeeder) -----
ADMIN_EMAIL=admin@sccit.local
ADMIN_PASSWORD=ChangeMe!2026

VITE_APP_NAME="${APP_NAME}"
