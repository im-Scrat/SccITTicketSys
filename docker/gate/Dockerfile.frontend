# syntax=docker/dockerfile:1
# =============================================================
#  Disposable frontend gate image (scripts/gates.sh --stack isolated).
#
#  Lockfile install + the exact source tree under test. Runs with no network.
#  PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD before `npm ci` for the reason given in
#  docker/node/Dockerfile: the glibc browsers could never run on Alpine.
# =============================================================
FROM node:22-alpine
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
