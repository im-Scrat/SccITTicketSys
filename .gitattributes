# Normalize all text to LF in the repo and on checkout.
# Critical: scripts/configs copied into Linux containers must be LF,
# otherwise shell entrypoints fail with "bad interpreter" on a Windows host.
* text=auto eol=lf

# Files that MUST stay LF regardless of platform
*.sh        text eol=lf
*.bash      text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
