root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web / JS / config files use 2-space indentation
[*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css,scss,html,vue,yml,yaml}]
indent_size = 2

# PHP follows PSR-12 (4 spaces)
[*.{php,blade.php}]
indent_size = 4

# Markdown: keep trailing whitespace (used for hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[{Makefile,*.mk}]
indent_style = tab
